<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_AutoRamp_AreaRatio" Id="{2cae9fbe-a2b7-47d1-b52c-c613185fedc9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_AutoRamp_AreaRatio
VAR
    // Ramp- og hastighetsinnstillinger
    fMaxSpeed         : LREAL := 0.15;     
    fRampTime         : LREAL := 2.0;      
    fPauseTime        : LREAL := 2.0;      
    fCycleTime        : LREAL := 0.01;     
    fBrakeDist        : LREAL := 0.08;     // Økt litt for finere bremsing mot endene
    
    // Grenser og retning
    fUpperLimit       : LREAL := 0.45;
    fLowerLimit       : LREAL := 0.05;     
    bDirectionUp      : BOOL := TRUE;      // Beholder retningen selv ved stopp
    
    // Status
    bInPause          : BOOL;
    fCurrentTimer     : LREAL;             
    fSpeed            : LREAL;             
    
    // Pressure Feedback (PF)
    ePFMode           : E_PressureFeedback := E_PressureFeedback.PF_ON; 
    fbPF_Area         : FB_PF_AreaRatio;    
    fTestKf           : LREAL := 0.00001;  
    fTestTf           : LREAL := 0.065;    
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ==========================================
// 1. AUTO RAMP LOGIKK (MED MINNE OG PAUSE)
// ==========================================
IF G_Inputs.bStartButton AND G_Mode.bRunning AND G_Mode.bAuto THEN
    
    // Sjekk om vi skal trigge pause (når vi når toppen eller bunnen)
    IF NOT bInPause THEN
        IF (bDirectionUp AND G_OPC.fPistonPosition >= (fUpperLimit - 0.01)) OR 
           (NOT bDirectionUp AND G_OPC.fPistonPosition <= (fLowerLimit + 0.01)) THEN
            bInPause := TRUE;
            fCurrentTimer := 0.0; // Start 2s pause-timer
        END_IF
    END_IF

    // Håndtering av tilstand: Pause vs Kjøring
    IF bInPause THEN
        fCurrentTimer := fCurrentTimer + fCycleTime;
        fSpeed := 0.0;
        
        // Vent i 2 sekunder før vi snur
        IF fCurrentTimer >= fPauseTime THEN
            bInPause := FALSE;
            bDirectionUp := NOT bDirectionUp; // Snu retning
            fCurrentTimer := 0.0;             // Reset for ny akselerasjon
        END_IF
    ELSE
        // Normal kjøring: Oppdater timer for akselerasjon
        fCurrentTimer := fCurrentTimer + fCycleTime;
        
        // Akselerasjons-rampe (Tidsbasert)
        fSpeed := LIMIT(0.0, (fCurrentTimer / fRampTime) * fMaxSpeed, fMaxSpeed);
        
        // Posisjonsbasert bremsing (Bremser både oppe og nede)
        IF bDirectionUp THEN
            IF G_OPC.fPistonPosition > (fUpperLimit - fBrakeDist) THEN
                fSpeed := LIMIT(0.12, (fUpperLimit - G_OPC.fPistonPosition) / fBrakeDist * fMaxSpeed, fSpeed);
            END_IF
        ELSE
            IF G_OPC.fPistonPosition < (fLowerLimit + fBrakeDist) THEN
                fSpeed := LIMIT(0.12, (G_OPC.fPistonPosition - fLowerLimit) / fBrakeDist * fMaxSpeed, fSpeed);
            END_IF
        END_IF
    END_IF
    
    // Sett retning på signalet (Sørger for riktig fortegn basert på bDirectionUp)
    G_OPC.fU := SEL(bDirectionUp, fSpeed, -fSpeed); 

ELSE
    // STOPP: Når startknappen slippes
    G_OPC.fU := 0.0;
    
    // Nullstill timeren slik at den starter mykt (ramper opp) neste gang du trykker
    fCurrentTimer := 0.0; 
    
    // VIKTIG: Vi resetter IKKE bDirectionUp her. 
    // Dette gjør at kranen fortsetter i samme retning som den var på vei.
END_IF

// ==========================================
// 2. PRESSURE FEEDBACK & VENTIL-TILPASNING
// ==========================================
fbPF_Area(
    bEnable := (ePFMode = E_PressureFeedback.PF_ON), 
    fJoystick := G_OPC.fU, 
    fPa := G_OPC.fPa, 
    fPb := G_OPC.fPb,
    fKf := fTestKf, 
    fTf := fTestTf, 
    fU_Out => G_OPC.fU            
);

// Deadband compensation (Legges på helt til slutt)
IF G_OPC.fU > 0.0 THEN
    G_OPC.fU := G_OPC.fU + G_Parameter.fDeadUp;
ELSIF G_OPC.fU < 0.0 THEN
    G_OPC.fU := G_OPC.fU - G_Parameter.fDeadDown;
END_IF

// Endelig sikkerhetsbegrensning
G_OPC.fU := LIMIT(-1.0, G_OPC.fU, 1.0);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>