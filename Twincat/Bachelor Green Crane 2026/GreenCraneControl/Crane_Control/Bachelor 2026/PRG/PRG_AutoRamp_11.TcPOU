<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_AutoRamp_11" Id="{2cae9fbe-a2b7-47d1-b52c-c613185fedc9}" SpecialFunc="None">
    <Declaration><![CDATA[VAR
    // Ramp- og hastighetsinnstillinger
    fMaxSpeed         : LREAL := 0.3;      
    fRampTime         : LREAL := 2.0;      
    fPauseTime        : LREAL := 2.0;      
    fCycleTime        : LREAL := 0.01;     
    fBrakeDist        : LREAL := 0.05;     // Begynn å bremse 5 cm før grensen
    
    // Grenser og retning
    fUpperLimit       : LREAL := 0.45;
    fLowerLimit       : LREAL := 0.05;
    bDirectionUp      : BOOL := TRUE;
    
    // Status
    bInPause          : BOOL;
    fCurrentTimer     : LREAL;             
    fSpeed            : LREAL;             // Mellomvariabel for beregnet fart
    
    // Pressure Feedback (PF)
    ePFMode : E_PressureFeedback := E_PressureFeedback.PF_ON; 
    fbPF_Area         : FB_PF_AreaRatio;    
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ==========================================
// 1. AUTO RAMP LOGIKK (KUN AUTO + STARTKNAPP)
// ==========================================
IF G_Inputs.bStartButton AND G_Mode.bRunning AND G_Mode.bAuto THEN
    
    fCurrentTimer := fCurrentTimer + fCycleTime;

    // Sjekk om vi har nådd målet (Gå i pause)
    IF NOT bInPause THEN
        IF (bDirectionUp AND G_OPC.fPistonPosition >= fUpperLimit) OR 
           (NOT bDirectionUp AND G_OPC.fPistonPosition <= fLowerLimit) THEN
            bInPause := TRUE;
            fCurrentTimer := 0.0; 
        END_IF
    END_IF

    // Håndter pause-slutt (snu retning)
    IF bInPause AND fCurrentTimer >= fPauseTime THEN
        bInPause := FALSE;
        bDirectionUp := NOT bDirectionUp;
        fCurrentTimer := 0.0; 
    END_IF

    // BEREGN HASTIGHET (OPP- OG NEDRAMPING)
    IF bInPause THEN
        fSpeed := 0.0;
    ELSE
        // 1. Start-rampe opp (Tidsbasert)
        fSpeed := LIMIT(0.0, (fCurrentTimer / fRampTime) * fMaxSpeed, fMaxSpeed);
        
        // 2. Bremse-rampe ned (Posisjonsbasert)
        IF bDirectionUp THEN
            IF G_OPC.fPistonPosition > (fUpperLimit - fBrakeDist) THEN
                fSpeed := LIMIT(0.05, (fUpperLimit - G_OPC.fPistonPosition) / fBrakeDist * fMaxSpeed, fSpeed);
            END_IF
        ELSE
            IF G_OPC.fPistonPosition < (fLowerLimit + fBrakeDist) THEN
                fSpeed := LIMIT(0.05, (G_OPC.fPistonPosition - fLowerLimit) / fBrakeDist * fMaxSpeed, fSpeed);
            END_IF
        END_IF
        
        // Sett retning (SEL velger mellom -fSpeed og fSpeed basert på bDirectionUp)
        G_OPC.fU := SEL(bDirectionUp, -fSpeed, fSpeed);
    END_IF

ELSE
    // Full stopp og nullstilling hvis knapp slippes eller modus endres
    G_OPC.fU := 0.0;
    fCurrentTimer := 0.0;
    bInPause := FALSE;
END_IF

// ==========================================
// 2. PRESSURE FEEDBACK (AREA RATIO)
// ==========================================
fbPF_Area(
    bEnable   := (ePFMode = E_PressureFeedback.PF_ON), 
    fJoystick := G_OPC.fU,            
    fPa       := G_OPC.fPa,
    fPb       := G_OPC.fPb,
    fU_Out    => G_OPC.fU            
);

// ==========================================
// 3. VENTIL-TILPASNING (DEADBAND & LIMIT)
// ==========================================
IF G_OPC.fU > 0.0 THEN
    G_OPC.fU := G_OPC.fU + G_Parameter.fDeadUp;
ELSIF G_OPC.fU < 0.0 THEN
    G_OPC.fU := G_OPC.fU - G_Parameter.fDeadDown;
END_IF

G_OPC.fU := LIMIT(-1.0, G_OPC.fU, 1.0);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>