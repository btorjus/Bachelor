<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fU_Testing" Id="{a2a695bb-a141-4af0-97b4-2d34bb7d91d9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM fU_Testing
VAR
    fU_TestValue      : LREAL := 0.0; 
    bEnableTesting    : BOOL  := FALSE;
    
    // Grenseverdier for sikkerhet
    fLimitDown        : LREAL := 0.10; // Stopper her på vei ned
    fLimitUp          : LREAL := 0.45; // Stopper her på vei opp
    
    bHitLimit         : BOOL;          // Indikator hvis grensen er nådd
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bEnableTesting THEN
    // 1. Begrens inngangsverdien mellom -1 og 1
    fU_TestValue := LIMIT(-1.0, fU_TestValue, 1.0);

    // 2. Sjekk retning mot posisjon fra G_OPC
    // Positiv fU_TestValue (> 0) betyr NED/UT
    // Negativ fU_TestValue (< 0) betyr OPP/INN
    IF (fU_TestValue > 0 AND G_OPC.fPistonPosition <= fLimitDown) OR 
       (fU_TestValue < 0 AND G_OPC.fPistonPosition >= fLimitUp) THEN
        
        G_OPC.fU := 0.0;  // Stopp signalet til ventilen
        bHitLimit := TRUE;
    ELSE
        G_OPC.fU := fU_TestValue; // Kjør manuelt
        bHitLimit := FALSE;
    END_IF
    
ELSE
    // Sikkerhet: Hvis manuell test ikke er på, skal fU alltid være 0
    G_OPC.fU := 0.0;
    bHitLimit := FALSE;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>