<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_Manual_PF_Gradient" Id="{8b698f07-a516-4b87-a0eb-cf4c6c35d59c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Manual_PF_Gradient

VAR
    bReturning        : BOOL;                 // True when returning home
    ePFMode           : E_PressureFeedback;   // PF mode (ON/OFF)
    
    fSelectedPressure : LREAL;                // Pa/Pb based on direction
    fDistance         : LREAL;                // Distance for breaking
    
    fbInitialPos      : FB_InitialPos;        // FB for initial position
    fbReturnTimer     : TON;                  // Timer for home command
    fbDamping         : FB_PF_GradientFiltered; // THE NEW FILTERED GRADIENT FB
    
    fDampingGain      : LREAL := 0.005;       // Tuning factor (start low!)

    // --- NYE VARIABLER FOR MYK START ---
    fSpeed            : LREAL;                // Mellomvariabel for fart
    fHomeTimer        : LREAL;                // Teller sekunder for oppramping
    fHomeRampTime     : LREAL := 4.0;         // Tid for å nå full fart (4s for veldig myk start)
    fHomeMaxSpeed     : LREAL := 0.15;        // Toppfart for hjemkjøring
    fCycleTime        : LREAL := 0.01;        // 10ms syklustid
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Update initial position
fbInitialPos(
    bEnable := G_Inputs.bStartButton AND G_Mode.bRunning,
    fCurrentPos := G_OPC.fPistonPosition
);

// 2. Return home logic (5s hold)
fbReturnTimer(IN := G_Inputs.bStartButton AND G_Mode.bRunning, PT := T#5S);
IF fbReturnTimer.Q THEN
    bReturning := TRUE;
END_IF

// Cancel return-home if joystick is activated 
IF ABS(G_OPC.fJoystick) > 0.1 THEN 
    bReturning := FALSE;
END_IF


// 3. Drive Logic (Home vs Manual)
IF bReturning THEN
    // Oppdater timer for akselerasjon (Myk start)
    fHomeTimer := fHomeTimer + fCycleTime;
    
    fDistance := ABS(G_OPC.fPistonPosition - 0.01); // Calculates distance home
    
    IF G_OPC.fPistonPosition > 0.01 THEN // If cylinder is above home point
        // Beregn myk oppstart
        fSpeed := (fHomeTimer / fHomeRampTime) * fHomeMaxSpeed;
        
        // Beregn bremsing nær målet (LIMIT sikrer minimumsfart på 0.12)
        fSpeed := LIMIT(0.12, fDistance * 2.0, fSpeed); 
        
        // Sett endelig utgangssignal for Home-funksjon
        G_OPC.fU := LIMIT(0.0, fSpeed, fHomeMaxSpeed);
    ELSE
        G_OPC.fU := 0.0;
        bReturning := FALSE;
        fHomeTimer := 0.0; // Reset timer for neste gang
    END_IF
ELSE
    // Nullstill timer når vi ikke kjører Home
    fHomeTimer := 0.0;
    
    IF G_Mode.bManual AND G_Mode.bRunning THEN // Manual mode
        G_OPC.fU := -G_OPC.fJoystick;
    ELSE
        G_OPC.fU := 0.0; 
    END_IF
END_IF

// 4. Select pressure sensor based on direction
IF G_OPC.fU > 0 THEN
    fSelectedPressure := G_OPC.fPb;
ELSIF G_OPC.fU < 0 THEN
    fSelectedPressure := G_OPC.fPa;
ELSE
    fSelectedPressure := 0.0;
END_IF

// 5. Apply the NEW Filtered Gradient Pressure Feedback
fbDamping(
    bEnable           := (ePFMode = E_PressureFeedback.PF_ON), 
    fJoystick         := G_OPC.fU,           
    fSelectedPressure := fSelectedPressure,  
    fDampingGain      := fDampingGain, 
    fU_Out            => G_OPC.fU            
);

// 6. Valve Deadband Compensation
IF G_OPC.fU > 0.0 THEN
    G_OPC.fU := G_OPC.fU + G_Parameter.fDeadUp;
ELSIF G_OPC.fU < 0.0 THEN
    G_OPC.fU := G_OPC.fU - G_Parameter.fDeadDown;
END_IF

// 7. Final safety limit
G_OPC.fU := LIMIT(-1.0, G_OPC.fU, 1.0);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>